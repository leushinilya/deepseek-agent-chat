DEEPSEEK_API_KEY=your_deepseek_api_key_here
PORT=3000
# deepseek-v4-flash is the default. Change to deepseek-v4-pro when needed.
DEEPSEEK_MODEL=deepseek-v4-flash
# OpenAI-compatible chat completions endpoint. Change this together with the key
# and model when using another compatible provider.
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# For local Flutter Web development only. Do not set this in production.
FRONTEND_ORIGIN=http://localhost:8080
